generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model RoutineActivity {
  id          String               @id @default(cuid())
  dayOfWeek   Int                  // 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat, 0=Sun
  title       String
  order       Int                  @default(0)
  completions ActivityCompletion[]
  createdAt   DateTime             @default(now())
}

model ActivityCompletion {
  id         String          @id @default(cuid())
  activityId String
  activity   RoutineActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  date       DateTime        @db.Date
  done       Boolean         @default(false)

  @@unique([activityId, date])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
